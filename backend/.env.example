# ── Database and queue ──
# Pooled URL for runtime (Supabase pooler), direct URL only for migrations.
DATABASE_URL=postgresql://fides:fides@localhost:5432/fides
DIRECT_URL=postgresql://fides:fides@localhost:5432/fides
REDIS_URL=redis://localhost:6379
# Runtime pool size per process. Keep it small on the free Supabase pooler.
DB_POOL_MAX=3
# all (default): API and job worker in one service. api or worker: lets a later split use the same image.
ROLE=all
# Audit rows older than this are deleted by the daily job. Login nonces and expired sessions are always pruned.
AUDIT_RETENTION_DAYS=365
PORT=3001
NODE_ENV=development
# Comma separated. Required in production. Empty means all origins (development only).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=100

# ── FIDES Desk (holders) ──
# Open owner decisions: no defaults. While unset, the holder gate stays closed.
# The $FIDES ERC-20 contract (0x...), the JSON-RPC URL of its chain, and the holder threshold in whole tokens.
TOKEN_CONTRACT=
TOKEN_RPC_URL=
MEMBER_MIN_BALANCE=

# ── Profile claims through "Login with X" (OAuth 2.0 with PKCE) ──
# Owner-provided X developer app. While X_CLIENT_ID or X_REDIRECT_URI is empty, claims stay closed.
# Set a spending limit in the X Developer Console before adding credits.
X_CLIENT_ID=
X_CLIENT_SECRET=
# The frontend /claim page URL registered as the callback in the X app.
X_REDIRECT_URI=
# X_API_URL=https://api.x.com

# ── Rating process ──
# Notice period before publication, in hours. Production refuses to boot below 48.
NOTICE_HOURS=48
# Pre-launch only. While true, ratings can be published without the notice proof and without the 48 hour wait,
# and a short NOTICE_HOURS is allowed in production. Leave it unset or false. Remove it at launch.
# PRELAUNCH_MODE=true

# ── Security ──
IP_HASH_SALT=change-me-to-a-random-string

# ── Staff access ──
# Owner-managed allowlist of EVM wallets: "<0x address>:<role>,<0x address>:<role>" with role analyst, committee or admin.
# Empty means nobody has staff access. Never put real addresses in this example file.
STAFF_WALLETS=

# ── Seed ──
# true seeds the FICTIONAL demo account @lunar_alpha. Must be false in production.
SEED_DEMO=true

# ── Development and tests only ──
# TOKEN_GATE_MOCK_BALANCE=100000
# MAINTENANCE_DISABLED=true
