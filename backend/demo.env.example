# Local demo settings. Copy to backend/.env.demo (ignored by git) and use only the demo:* npm scripts.
# These values never touch Supabase, Railway or the real X API. The scripts refuse to run when the
# database or queue is not on this machine.
DOTENV_CONFIG_PATH=.env.demo
NODE_ENV=development
PORT=3001

# Local Postgres and Redis from docker-compose.dev.yml. The compose file creates the database "fides".
DATABASE_URL=postgresql://fides:fides@localhost:5432/fides
DIRECT_URL=postgresql://fides:fides@localhost:5432/fides
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# Fictional accounts: @lunar_alpha (covered, 182,000 followers), @demo_newcomer (12,000, not covered),
# @demo_small (1,200, below the minimum). Login with X is replaced by a small local page.
X_OAUTH_MOCK=true
X_REDIRECT_URI=http://localhost:3000/claim
SEED_DEMO=true

# Optional: your own EVM wallet as staff, to show the staff console in the video.
# Format: "<0x address>:<role>" with role analyst, committee or admin.
STAFF_WALLETS=

# Keep the demo quiet and self contained.
IP_HASH_SALT=demo-only-not-a-secret
NOTICE_HOURS=48
# PRELAUNCH_MODE=true
