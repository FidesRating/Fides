{
  "name": "fides-backend",
  "version": "1.0.0",
  "description": "Backend for FIDES — credibility ratings for crypto influencers",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "demo:migrate": "node --env-file=.env.demo scripts/demo-guard.js && node --env-file=.env.demo node_modules/prisma/build/index.js migrate deploy",
    "demo:seed": "node --env-file=.env.demo scripts/demo-guard.js && node --env-file=.env.demo node_modules/prisma/build/index.js db seed",
    "demo:start": "node --env-file=.env.demo scripts/demo-guard.js && node --env-file=.env.demo node_modules/@nestjs/cli/bin/nest.js start --watch"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bs58": "^6.0.0",
    "bullmq": "^5.41.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
